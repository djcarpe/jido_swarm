<Layouts.flash_group flash={@flash} />

<div class="min-h-screen bg-base-200">
  <header class="navbar bg-base-100 border-b border-base-300 px-4">
    <div class="flex-1 gap-3">
      <span class="text-lg font-semibold">Jido Swarm</span>
      <span class="badge badge-sm badge-outline">
        {length(@status.workers)} worker{if length(@status.workers) == 1, do: "", else: "s"}
      </span>
      <span :if={@status.queue.pending > 0} class="badge badge-sm badge-warning">
        {@status.queue.pending} queued
      </span>
      <span :if={@status.queue.busy > 0} class="badge badge-sm badge-info">
        {@status.queue.busy} running
      </span>
      <span :if={Map.get(@hive.counts, "open", 0) > 0} class="badge badge-sm badge-accent">
        {Map.get(@hive.counts, "open", 0)} open on the board
      </span>
    </div>

    <div class="flex-none gap-2 items-center">
      <span class={["badge badge-sm", status_tone(active_provider(@status).ready?)]}>
        {active_provider(@status).name}
      </span>
      <span class={["badge badge-sm", status_tone(@graph_available?)]}>
        graph {if @graph_available?, do: "up", else: "off"}
      </span>
      <span
        :if={@mesh.me}
        class="badge badge-sm badge-ghost font-mono"
        title="This replica's origin in the mesh; every write it makes carries this stamp"
      >
        {@mesh.me.origin}
      </span>
      <span
        :if={@glider.totals.calls > 0}
        class="badge badge-sm badge-ghost font-mono"
        title="Glider operations since start"
      >
        {format_count(@glider.totals.calls)} ops
      </span>
      <span
        :if={@glider.totals.error_rate > 0}
        class="badge badge-sm badge-error font-mono"
        title="Share of Glider operations that failed"
      >
        {@glider.totals.error_rate}% err
      </span>
      <button class="btn btn-sm btn-primary" phx-click="run_cycle">Run a cycle</button>
    </div>
  </header>

  <div :if={not active_provider(@status).ready?} class="alert alert-warning rounded-none">
    <span>{active_provider(@status).hint}</span>
  </div>

  <div :for={failure <- @status.failures} class="alert alert-error rounded-none text-sm">
    <div>
      <span class="font-semibold">Jobs are failing.</span>
      <span>{explain_failure(failure.error)}</span>
      <div class="text-xs opacity-70 mt-1 font-mono">{failure.label}</div>
    </div>
  </div>

  <div :if={not @status.can_publish?} class="alert alert-info rounded-none text-sm">
    <span>{@status.publish_hint}</span>
  </div>

  <main class="grid grid-cols-1 lg:grid-cols-5 gap-4 p-4">
    <%!-- Conversation --%>
    <section class="lg:col-span-3 flex flex-col bg-base-100 rounded-box border border-base-300 h-[calc(100vh-11rem)]">
      <div id="transcript" class="flex-1 overflow-y-auto p-4 space-y-3">
        <div :if={@turns == []} class="text-center text-base-content/60 py-12">
          <p class="font-medium">Ask the swarm something.</p>
          <p class="text-sm mt-1">
            It knows about jido, glider and glider_ex — or press
            <span class="font-mono">Run a cycle</span>
            to have it go and look.
          </p>
        </div>

        <div :for={turn <- @turns} class={["chat", chat_side(turn)]}>
          <div class="chat-header text-xs opacity-60">
            {turn.role}
            <span :if={turn[:worker] not in [nil, ""]} class="ml-1 font-mono">{turn.worker}</span>
            <time class="ml-1">{format_time(turn[:at])}</time>
          </div>
          <div class={["chat-bubble whitespace-pre-wrap", chat_tone(turn)]}>{turn.body}</div>
        </div>

        <div :if={@pending_reply} class="chat chat-start">
          <div class="chat-bubble">
            <span class="loading loading-dots loading-sm"></span>
          </div>
        </div>
      </div>

      <form
        id="composer"
        phx-submit="send"
        phx-change="compose"
        class="border-t border-base-300 p-3 flex gap-2"
      >
        <input
          type="text"
          name="message"
          value={@composer}
          autocomplete="off"
          placeholder="Ask the swarm…"
          class="input input-bordered flex-1"
        />
        <button type="submit" class="btn btn-primary" disabled={@pending_reply != nil}>
          Send
        </button>
      </form>
    </section>

    <%!-- Swarm state --%>
    <aside class="lg:col-span-2 space-y-4 h-[calc(100vh-11rem)] overflow-y-auto">
      <div class="stats stats-horizontal w-full bg-base-100 border border-base-300">
        <div class="stat py-3">
          <div class="stat-title text-xs">Findings</div>
          <div class="stat-value text-2xl">{@summary.findings}</div>
        </div>
        <div class="stat py-3">
          <div class="stat-title text-xs">Proposals</div>
          <div class="stat-value text-2xl">{@summary.proposals}</div>
        </div>
        <div class="stat py-3">
          <div class="stat-title text-xs">Attempts</div>
          <div class="stat-value text-2xl">{@summary.attempts}</div>
        </div>
      </div>

      <div class="card bg-base-100 border border-base-300">
        <div class="card-body p-4 gap-2">
          <h2 class="card-title text-sm">Pool</h2>
          <div class="text-xs opacity-70">
            {@status.autoscaler.min_workers}–{@status.autoscaler.max_workers} workers,
            +{@status.autoscaler.scale_step} per scale-out, retire after {div(
              @status.autoscaler.idle_ttl,
              1000
            )}s idle
          </div>
          <div class="flex flex-wrap gap-1">
            <span :for={worker <- @status.workers} class="badge badge-sm badge-outline font-mono">
              {worker}
            </span>
          </div>
          <div :if={@status.queue.running != []} class="mt-1 space-y-1">
            <div :for={job <- @status.queue.running} class="text-xs flex justify-between gap-2">
              <span class="font-mono truncate">{job.worker}</span>
              <span class="opacity-70 truncate">{JidoSwarm.Job.label(job)}</span>
            </div>
          </div>
        </div>
      </div>

      <div class="card bg-base-100 border border-base-300">
        <div class="card-body p-4 gap-2">
          <h2 class="card-title text-sm">Repositories</h2>
          <div :for={repo <- @repos} class="flex items-center justify-between gap-2">
            <span class="font-mono text-sm">{repo.name}</span>
            <span class="flex gap-1">
              <button class="btn btn-xs" phx-click="survey" phx-value-repo={repo.name}>
                survey
              </button>
              <button class="btn btn-xs" phx-click="propose" phx-value-repo={repo.name}>
                propose
              </button>
            </span>
          </div>
        </div>
      </div>

      <div class="card bg-base-100 border border-base-300">
        <div class="card-body p-4 gap-2">
          <div role="tablist" class="tabs tabs-bordered">
            <button
              :for={
                {tab, label} <- [
                  hive: "Hive",
                  findings: "Findings",
                  proposals: "Proposals",
                  attempts: "Attempts",
                  activity: "Activity",
                  glider: "Glider"
                ]
              }
              role="tab"
              class={["tab", @tab == tab && "tab-active"]}
              phx-click="tab"
              phx-value-tab={tab}
            >
              {label}
            </button>
          </div>

          <div :if={@tab == :hive} id="hive" class="space-y-3 pt-2 text-sm">
            <%!-- The memory is shared: who wrote it, and what is arriving now. --%>
            <.replica_strip :if={@mesh.me} mesh={@mesh} />
            <.delta_ticker :if={@mesh.me} mesh={@mesh} />

            <div class="flex flex-wrap gap-1">
              <span
                :for={status <- ~w(open claimed blocked split done failed)}
                :if={Map.get(@hive.counts, status, 0) > 0}
                class={["badge badge-sm", hive_badge(status)]}
              >
                {Map.get(@hive.counts, status)} {status}
              </span>
              <span :if={@hive.counts == %{}} class="text-xs opacity-60">
                The board is empty. Add a goal below, or connect an agent over MCP.
              </span>
            </div>

            <div :if={@hive.goals != []} class="space-y-1">
              <div class="text-xs opacity-60">Goals</div>
              <div :for={goal <- @hive.goals} class="space-y-0.5">
                <div class="flex justify-between gap-2">
                  <span class="truncate">
                    <span class="badge badge-xs badge-outline mr-1">P{goal.priority}</span>
                    {goal.title}
                  </span>
                  <span class="text-xs opacity-60 shrink-0">{goal.done}/{goal.tasks}</span>
                </div>
                <progress
                  class="progress progress-success w-full h-1"
                  value={progress(goal)}
                  max="100"
                ></progress>
              </div>
            </div>

            <div :if={@hive.in_flight != []} class="space-y-1">
              <div class="text-xs opacity-60">In flight</div>
              <div :for={t <- @hive.in_flight} class="flex justify-between gap-2 text-xs">
                <span class="truncate">{t.title}</span>
                <span class="shrink-0 font-mono opacity-70">{t.agent} · {lease_left(t.lease_until)}</span>
              </div>
            </div>

            <div :if={@hive.open != []} class="space-y-1">
              <div class="text-xs opacity-60">Open, best first</div>
              <div :for={t <- @hive.open} class="flex justify-between gap-2 text-xs">
                <span class="truncate">
                  <span class="badge badge-xs badge-outline mr-1">P{t.priority}</span>{t.title}
                </span>
                <span :if={t.skills != []} class="shrink-0 opacity-60">{Enum.join(t.skills, ", ")}</span>
              </div>
            </div>

            <div :if={@hive.open_questions != []} class="space-y-1">
              <div class="text-xs opacity-60">Open questions</div>
              <div :for={q <- @hive.open_questions} class="text-xs border-l-2 border-warning pl-2">
                {q.text}
                <span class="opacity-60">— {q.agent}</span>
              </div>
            </div>

            <div :if={@hive.recent_insights != []} class="space-y-1">
              <div class="text-xs opacity-60">What the swarm learned</div>
              <div
                :for={i <- @hive.recent_insights}
                class="text-xs border-l-2 border-base-300 pl-2"
              >
                <span class="badge badge-xs badge-outline mr-1">{i.kind}</span>
                {i.text}
                <span class="opacity-60">
                  — {i.agent}, conf {i.confidence}{if i.consensus != 0,
                    do: ", #{i.consensus} votes"}
                </span>
              </div>
            </div>

            <div :if={@hive.agents != []} class="space-y-1">
              <div class="text-xs opacity-60">Agents on the board</div>
              <div class="flex flex-wrap gap-1">
                <span
                  :for={a <- @hive.agents}
                  class="badge badge-sm badge-outline"
                  title={Enum.join(a.skills, ", ")}
                >
                  {a.name} <span class="opacity-60 ml-1">{a.kind} · {a.status}</span>
                </span>
              </div>
            </div>

            <form id="hive-goal" phx-submit="hive_add_goal" class="flex gap-1">
              <input
                type="text"
                name="title"
                placeholder="New goal…"
                class="input input-bordered input-xs flex-1"
              />
              <select name="priority" class="select select-bordered select-xs">
                <option :for={p <- 5..1//-1} value={p} selected={p == 3}>P{p}</option>
              </select>
              <button type="submit" class="btn btn-xs">add goal</button>
            </form>

            <form id="hive-task" phx-submit="hive_add_task" class="flex flex-wrap gap-1">
              <input
                type="text"
                name="title"
                placeholder="New task…"
                class="input input-bordered input-xs flex-1 min-w-40"
              />
              <input
                type="text"
                name="skills"
                placeholder="skills, comma separated"
                class="input input-bordered input-xs w-40"
              />
              <select name="goal" class="select select-bordered select-xs max-w-40">
                <option value="">no goal</option>
                <option :for={g <- @hive.goals} value={g.key}>{g.title}</option>
              </select>
              <button type="submit" class="btn btn-xs">add task</button>
            </form>

            <div class="text-xs opacity-60">
              Agents join from anywhere over MCP:
              <code class="font-mono block mt-1 select-all">claude mcp add --transport http hive {mcp_url()}</code>
            </div>
          </div>

          <div :if={@tab == :findings} class="space-y-2 pt-2">
            <p :if={@findings == []} class="text-xs opacity-60">
              Nothing learned yet. Run a survey.
            </p>
            <div
              :for={finding <- Enum.take(@findings, 25)}
              class="text-sm border-l-2 border-base-300 pl-2"
            >
              <span class="badge badge-xs badge-outline mr-1">{finding.kind}</span>
              {finding.summary}
            </div>
          </div>

          <div :if={@tab == :proposals} class="space-y-2 pt-2">
            <p :if={@proposals == []} class="text-xs opacity-60">
              No proposals yet. Survey a repository first, then press propose.
            </p>
            <div
              :for={proposal <- Enum.take(@proposals, 25)}
              class="text-sm border-l-2 border-base-300 pl-2"
            >
              <div class="flex items-start justify-between gap-2">
                <div>
                  <span class={["badge badge-xs mr-1", proposal_tone(proposal.status)]}>
                    {proposal.status}
                  </span>
                  <span class="font-medium">{proposal.title}</span>
                  <span class="font-mono text-xs opacity-60 ml-1">{proposal.repo}</span>
                </div>
                <button
                  :if={proposal.status == "proposed"}
                  class="btn btn-xs btn-primary shrink-0"
                  phx-click="implement"
                  phx-value-key={proposal.key}
                >
                  implement
                </button>
              </div>
              <p class="text-xs opacity-70 mt-1">{proposal.rationale}</p>
            </div>
          </div>

          <div :if={@tab == :attempts} class="space-y-2 pt-2">
            <p :if={@attempts == []} class="text-xs opacity-60">
              No implementation attempts yet.
            </p>
            <div
              :for={attempt <- Enum.take(@attempts, 25)}
              class="text-sm border-l-2 border-base-300 pl-2"
            >
              <span class={["badge badge-xs mr-1", attempt_tone(attempt.status)]}>
                {attempt.status}
              </span>
              <span class="font-mono text-xs">{attempt.repo}</span>
              <span class="font-mono text-xs opacity-60 ml-1">{attempt.branch}</span>
              <a
                :if={attempt.pr_url not in [nil, ""]}
                href={attempt.pr_url}
                target="_blank"
                rel="noopener"
                class="link link-primary text-xs ml-1"
              >
                pull request
              </a>
              <p
                :if={attempt.note not in [nil, ""]}
                class="text-xs opacity-60 mt-1 font-mono whitespace-pre-wrap"
              >
                {String.slice(attempt.note, 0, 400)}
              </p>
            </div>
          </div>

          <div :if={@tab == :glider} class="space-y-3 pt-2">
            <p :if={@glider.totals.calls == 0} class="text-xs opacity-60">
              No graph operations recorded yet.
            </p>

            <div :if={@glider.totals.calls > 0} class="space-y-3">
              <%!-- Headline usage --%>
              <div class="grid grid-cols-2 gap-2 text-xs">
                <div class="bg-base-200 rounded p-2">
                  <div class="opacity-60">Operations</div>
                  <div class="text-lg font-mono">{format_count(@glider.totals.calls)}</div>
                </div>
                <div class="bg-base-200 rounded p-2">
                  <div class="opacity-60">Time in Glider</div>
                  <div class="text-lg font-mono">{format_us(@glider.totals.busy_us)}</div>
                </div>
                <div class="bg-base-200 rounded p-2">
                  <div class="opacity-60">Rows read</div>
                  <div class="text-lg font-mono">{format_count(@glider.totals.rows)}</div>
                </div>
                <div class="bg-base-200 rounded p-2">
                  <div class="opacity-60">Entities written</div>
                  <div class="text-lg font-mono">{format_count(@glider.totals.touched)}</div>
                </div>
              </div>

              <div :if={@glider.totals.errors > 0} class="alert alert-error p-2 text-xs">
                <span>
                  {@glider.totals.errors} failed
                  ({@glider.totals.error_rate}% of all operations)
                </span>
              </div>

              <%!-- Throughput over the retained window --%>
              <div :if={@glider.series != []}>
                <div class="flex items-baseline justify-between text-xs opacity-60 mb-1">
                  <span>Operations/sec</span>
                  <span>last {div(@glider.window_seconds, 60)}m</span>
                </div>
                <svg viewBox="0 0 240 32" class="w-full h-8" preserveAspectRatio="none">
                  <polyline
                    points={sparkline(@glider.series, :calls)}
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.5"
                    class="text-primary"
                    vector-effect="non-scaling-stroke"
                  />
                </svg>
              </div>

              <%!-- Per-operation latency and volume --%>
              <div class="overflow-x-auto">
                <table class="table table-xs">
                  <thead>
                    <tr>
                      <th>op</th>
                      <th class="text-right">calls</th>
                      <th class="text-right">p50</th>
                      <th class="text-right">p95</th>
                      <th class="text-right">p99</th>
                      <th class="text-right">max</th>
                      <th class="text-right">err</th>
                    </tr>
                  </thead>
                  <tbody>
                    <tr :for={op <- @glider.operations} class="font-mono">
                      <td>{op.operation}</td>
                      <td class="text-right">{format_count(op.calls)}</td>
                      <td class="text-right">{format_us(op.p50_us)}</td>
                      <td class="text-right">{format_us(op.p95_us)}</td>
                      <td class="text-right">{format_us(op.p99_us)}</td>
                      <td class="text-right opacity-60">{format_us(op.max_us)}</td>
                      <td class={["text-right", error_tone(op.error_rate)]}>
                        {if op.errors > 0, do: "#{op.error_rate}%", else: "—"}
                      </td>
                    </tr>
                  </tbody>
                </table>
                <p class="text-xs opacity-50 mt-1">
                  Percentiles over the most recent {@glider.sample_limit} calls per operation.
                </p>
              </div>

              <%!-- What the graph is being asked to do --%>
              <div :if={@glider.cypher != []}>
                <div class="text-xs opacity-60 mb-1">By statement</div>
                <div class="flex flex-wrap gap-1">
                  <span
                    :for={entry <- Enum.take(@glider.cypher, 12)}
                    class={["badge badge-sm font-mono", entry.errors > 0 && "badge-error"]}
                    title={"#{entry.calls} calls, #{entry.errors} failed"}
                  >
                    {entry.keyword} {format_count(entry.calls)}
                  </span>
                </div>
              </div>

              <button class="btn btn-xs btn-ghost" phx-click="reset_metrics">
                reset metrics
              </button>
            </div>
          </div>

          <div :if={@tab == :activity} class="space-y-1 pt-2">
            <p :if={@status.history == []} class="text-xs opacity-60">No finished jobs yet.</p>
            <div :for={entry <- @status.history} class="text-xs">
              <div class="flex justify-between gap-2">
                <span class="truncate">
                  <span class={["badge badge-xs mr-1", status_tone(entry.status == :done)]}>
                    {entry.status}
                  </span>
                  {entry.label}
                </span>
                <span class="opacity-60 shrink-0">{format_duration(entry.duration_ms)}</span>
              </div>
              <div :if={entry.error} class="text-error opacity-80 pl-1 mt-0.5">
                {explain_failure(entry.error)}
              </div>
            </div>
          </div>
        </div>
      </div>
    </aside>
  </main>
</div>
