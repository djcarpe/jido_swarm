# Build artifacts and caches never belong in the image context.
_build/
deps/
.git/
.elixir_ls/
tmp/
node_modules/
assets/node_modules/
priv/static/assets/
priv/static/cache_manifest.json

# The vendored trees are needed, but their own build output is not.
vendor/*/_build/
vendor/*/deps/
vendor/*/target/
vendor/*/native/*/target/
vendor/*/tmp/

# Local notes and logs
*.log
k8s/
